# Free Gmail SMTP setup:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create a Google App Password for Mail.
# 3. Copy this file to `.env` and fill in the values below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_TO=bossiesgym@gmail.com
# Optional: second recipient — both MAIL_TO and MAIL_TO_2 will receive all form submissions.
# MAIL_TO_2=second-address@gmail.com

# Optional: override the EHLO domain used when connecting to the SMTP server.
# Defaults to bossiesgym.co.za — change this if deploying under a different domain.
# SMTP_EHLO_HOST=bossiesgym.co.za

# Optional: override the HTTP server port.
# Defaults to 3001 in development (NODE_ENV != production) and 5173 in production.
# PORT=5173

# ─── Analytics (Supabase) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only — never bundled to the client. Find this in Supabase Studio:
# Settings → API → service_role key (bypasses RLS, used by /api/dashboard/* only).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only dashboard passphrase — checked in server.mjs, never bundled to the client.
DASHBOARD_PASS=your-dashboard-passphrase

# ─── AI Sales Agent (Ollama) ─────────────────────────────────────────────────
# Auto-drafts replies to website enquiries (contact form + free-trial CTA)
# from the curated FAQ knowledge base (src/data/faqQA.js), via a remote
# Ollama server. Server-only — never bundled to the client.
#
# Leaving OLLAMA_ENDPOINT unset disables this feature entirely and safely:
# handleSendEnquiry falls back to exactly today's behaviour (internal
# notification email only, no AI reply attempted).
# OLLAMA_ENDPOINT=https://your-ollama-host:11434
# OLLAMA_MODEL=llama3
# Optional — only needed if the remote Ollama server requires auth.
# OLLAMA_API_KEY=your-ollama-api-key
# Optional — request timeout in ms before falling back to a deflection reply. Defaults to 9000.
# OLLAMA_TIMEOUT_MS=9000
